# ------------------------------------------------------------------
# IR-SAM API + Worker — runtime configuration
# Copy to .env (or .env.local) and edit. All vars are prefixed IRSAM_.
# ------------------------------------------------------------------

# Environment: dev | staging | prod
IRSAM_ENV=dev
IRSAM_LOG_LEVEL=INFO

# HTTP
IRSAM_HOST=0.0.0.0
IRSAM_PORT=8000
IRSAM_ALLOWED_ORIGINS=["http://localhost:3000"]
IRSAM_API_ROOT_PATH=

# Auth
# IMPORTANT: generate a strong random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IRSAM_JWT_SECRET=change-me-please-use-a-long-random-string
IRSAM_JWT_ALGORITHM=HS256
IRSAM_JWT_TTL_MINUTES=720
IRSAM_COOKIE_NAME=irsam_session
IRSAM_COOKIE_SECURE=false
IRSAM_COOKIE_SAMESITE=lax

# Owner credentials (created on first boot)
IRSAM_OWNER_EMAIL=owner@example.com
IRSAM_OWNER_PASSWORD=change-me-too

# Database (Postgres in prod; SQLite is fine for local prototyping)
IRSAM_DATABASE_URL=postgresql+asyncpg://irsam:irsam@postgres:5432/irsam

# Redis (for Arq worker + scan-event pubsub)
IRSAM_REDIS_URL=redis://redis:6379/0

# Symmetric encryption key for stored credentials (Fernet, 32 url-safe b64 bytes)
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IRSAM_SECRETS_FERNET_KEY=generate-with-fernet-generate_key

# Where ephemeral repo clones are written
IRSAM_WORKSPACE_DIR=/tmp/irsam/workspace

# GitHub
IRSAM_GITHUB_API_BASE=https://api.github.com
