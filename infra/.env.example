# Copy to .env (in the infra/ folder) before running docker compose up.

POSTGRES_USER=irsam
POSTGRES_PASSWORD=irsam
POSTGRES_DB=irsam
POSTGRES_PORT=5432

REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000

# IRSAM application config (passed straight into api + worker containers)
IRSAM_ENV=prod
IRSAM_LOG_LEVEL=INFO
IRSAM_DATABASE_URL=postgresql+asyncpg://irsam:irsam@postgres:5432/irsam
IRSAM_REDIS_URL=redis://redis:6379/0
IRSAM_ALLOWED_ORIGINS=["http://localhost:3000"]
IRSAM_JWT_SECRET=replace-me
IRSAM_SECRETS_FERNET_KEY=replace-me-32b-url-safe-base64
IRSAM_OWNER_EMAIL=owner@example.com
IRSAM_OWNER_PASSWORD=replace-me
IRSAM_COOKIE_SECURE=false

NEXT_PUBLIC_API_BASE=http://localhost:8000
