# Database Credentials
POSTGRES_USER=irsam
POSTGRES_PASSWORD=irsam
POSTGRES_DB=irsam
POSTGRES_PORT=5432

# Port assignments (Matches the hardcoded ports in your compose file)
REDIS_PORT=6380
API_PORT=8001
WEB_PORT=3001

# IRSAM application config
IRSAM_ENV=prod
IRSAM_LOG_LEVEL=INFO
# Use the proven SQL₀ parser (sql0) instead of the sqlglot v1 backend.
# The v1 backend silently drops the FROM-clause table when the FROM node
# cannot be fully resolved, producing invalid SQL ("SELECT * FROM WHERE ...").
# sql0 is the formally-specified subset used in the soundness proof and
# correctly raises SQL0AmbiguousIntent when a hole appears in table-name
# position, triggering a Stage-D abstention for Scenario B.
IRSAM_SQL_PARSER=sql0
IRSAM_DATABASE_URL=postgresql+asyncpg://irsam:irsam@postgres:5432/irsam
IRSAM_REDIS_URL=redis://redis:6379/0
IRSAM_ALLOWED_ORIGINS=["http://localhost:3001"]
IRSAM_JWT_SECRET=randomsecurething
IRSAM_SECRETS_FERNET_KEY=CVkijmkjbN2kYBjXqlJIqPuo6pdXggG9U_SUWzxPIXY=

# Your actual administrator log-in credentials
IRSAM_OWNER_EMAIL=admin@example.com
IRSAM_OWNER_PASSWORD=admin2026
IRSAM_COOKIE_SECURE=false

# Points Next.js frontend to the customized API gateway
NEXT_PUBLIC_API_BASE=http://localhost:8001